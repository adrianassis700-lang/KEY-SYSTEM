local Validating = false

local function SetControlsEnabled(enabled)
    VerifyButton.Active = enabled
    GetKeyButton.Active = enabled
    KeyInput.Active = enabled
end

local function ValidateKey()
    if Validating then return end

    local Key = KeyInput.Text

    if not Key or Key:gsub("%s+", "") == "" then
        Status.Text = "Digite uma Key antes de continuar."
        Status.TextColor3 = COLORS.Error
        return
    end

    Validating = true
    SetControlsEnabled(false)
    Status.Text = "Verificando Key..."
    Status.TextColor3 = COLORS.Green

    local Body = HttpService:JSONEncode({key = Key, userid = LocalPlayer.UserId})
    local RequestFunction = (syn and syn.request) or (http and http.request) or request or http_request

    local RequestOk, ResponseBody

    if RequestFunction then
        RequestOk, ResponseBody = pcall(function()
            local Response = RequestFunction({Url = API_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = Body})
            return Response.Body
        end)
    else
        RequestOk, ResponseBody = pcall(function()
            return HttpService:PostAsync(API_URL, Body, Enum.HttpContentType.ApplicationJson)
        end)
    end

    if not RequestOk or not ResponseBody then
        Validating = false
        SetControlsEnabled(true)
        Status.Text = "Falha ao conectar com o servidor."
        Status.TextColor3 = COLORS.Error
        return
    end

    local DecodeOk, Data = pcall(function() return HttpService:JSONDecode(ResponseBody) end)

    if not DecodeOk or not Data then
        Validating = false
        SetControlsEnabled(true)
        Status.Text = "Resposta inválida do servidor."
        Status.TextColor3 = COLORS.Error
        return
    end

    if Data.valido == true then
        Status.Text = Data.mensagem or "Key validada com sucesso."
        Status.TextColor3 = COLORS.Green
        task.wait(0.4)
        -- SALVA A KEY
        salvarKey(Key)
        -- ANIMAÇÃO
        PlaySuccessSequence()
    else
        Validating = false
        SetControlsEnabled(true)
        Status.Text = Data.mensagem or "Key inválida."
        Status.TextColor3 = COLORS.Error
    end
end

VerifyButton.MouseButton1Click:Connect(ValidateKey)

KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then ValidateKey() end
end)

