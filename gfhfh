local function gerarDeviceID()
    local id = ""
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    for _ = 1, 32 do
        local randomIndex = math.random(1, #chars)
        id = id .. chars:sub(randomIndex, randomIndex)
    end
    return "DEV_" .. id
end

local function getDeviceID()
    local deviceID = nil
    
    pcall(function()
        if readfile and isfile and isfile(DEVICE_ID_FILE) then
            deviceID = readfile(DEVICE_ID_FILE)
        end
    end)
    
    if not deviceID or deviceID == "" then
        deviceID = gerarDeviceID()
        pcall(function()
            if writefile then
                writefile(DEVICE_ID_FILE, deviceID)
            end
        end)
    end
    
    return deviceID
end

local function salvarKey(key)
    pcall(function()
        if writefile then
            local dados = {
                key = key,
                deviceID = getDeviceID(),
                salvoEm = os.time()
            }
            writefile(KEY_FILE, HttpService:JSONEncode(dados))
        end
    end)
end

local function carregarKeySalva()
    local key = nil
    
    pcall(function()
        if readfile and isfile and isfile(KEY_FILE) then
            local dados = HttpService:JSONDecode(readfile(KEY_FILE))
            if dados and dados.key and dados.deviceID then
                if dados.deviceID == getDeviceID() then
                    key = dados.key
                end
            end
        end
    end)
    
    return key
end

local function limparKeySalva()
    pcall(function()
        if writefile then
            writefile(KEY_FILE, "")
        end
    end)
end

--//====================================================//
--// VALIDAÇÃO RÁPIDA (SILENCIOSA)
--//====================================================//

local function validarKeyRapida(key)
    local Body = HttpService:JSONEncode({key = key, userid = LocalPlayer.UserId})
    local RequestFunction = (syn and syn.request) or (http and http.request) or request or http_request

    local RequestOk, ResponseBody

    if RequestFunction then
        RequestOk, ResponseBody = pcall(function()
            local Response = RequestFunction({Url = API_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = Body})
            return Response.Body
        end)
    else
        RequestOk, ResponseBody = pcall(function()
            return HttpService:PostAsync(API_URL, Body, Enum.HttpContentType.ApplicationJson)
        end)
    end

    if not RequestOk or not ResponseBody then
        return false
    end

    local DecodeOk, Data = pcall(function() return HttpService:JSONDecode(ResponseBody) end)

    if not DecodeOk or not Data then
        return false
    end

    return Data.valido == true
end

